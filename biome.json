{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"src/**",
			"tests/**",
			"scripts/**",
			"experiments/**",
			"!experiments/konva/.next",
			"!experiments/konva/next-env.d.ts",
			"*.config.*",
			"!tmp",
			"!node_modules",
			"!.next",
			"!docs/evidence"
		]
	},
	"formatter": { "enabled": false },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } },
	"assist": { "enabled": false }
}
