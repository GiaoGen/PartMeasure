# P0-0 boots without these. Populate only in an ignored .env.local in P0-1.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Prefer the current secret key.
SUPABASE_SECRET_KEY=
# Server-only PostgreSQL transaction-pooler URL (proposal; not wired in P0-0).
DATABASE_URL=
# Remote CLI operations require separate approval; not used by this scaffold.
SUPABASE_PROJECT_REF=
