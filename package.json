{
  "name": "partmeasure",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.12.1 <12"
  },
  "scripts": {
    "verify:fix-c": "node --conditions=react-server --import tsx scripts/fix-c/verify.ts",
    "ops:status": "node --conditions=react-server --import tsx scripts/maintenance/status-cli.ts",
    "ops:backup": "node --conditions=react-server --import tsx scripts/maintenance/backup-cli.ts",
    "ops:cleanup": "node --conditions=react-server --import tsx scripts/p3-03/cleanup-uploads.ts",
    "diagnose:direct": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/performance/auth-direct.ps1",
    "diagnose:connection": "node --conditions=react-server --import tsx scripts/maintenance/connection-cli.ts",
    "cv:build": "node scripts/build-cv.mjs",
    "predev": "npm run cv:build",
    "prebuild": "npm run cv:build",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint . --error-on-warnings",
    "typecheck": "next typegen --webpack && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db": "supabase",
    "db:migration:new": "supabase migration new",
    "licenses": "node scripts/license-inventory.mjs",
    "lab:images": "node scripts/labs/generate-images.mjs",
    "lab:konva:build": "next build experiments/konva --webpack",
    "lab:konva:start": "next start experiments/konva --hostname 127.0.0.1 --port 3102",
    "lab:konva:test": "playwright test --config experiments/konva/playwright.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@techstark/opencv-js": "4.12.0-release.1",
    "konva": "10.9.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-konva": "19.3.2",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "tus-js-client": "4.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
