# Populate an ignored .env.local. APP_URL is the exact allowed browser Origin.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Prefer the current secret key.
SUPABASE_SECRET_KEY=
# Restricted partmeasure_runtime transaction-pooler URL; never postgres/service_role.
DATABASE_URL=
# Dedicated restricted-role session-mode pooler (5432) or direct connections.
# Transaction pooler 6543 cannot LISTEN. Server-only realtime events, not an upload worker.
EVENT_DATABASE_URL=
# Supabase Dashboard SSL Certificate, kept outside version control.
DATABASE_CA_FILE=
# Hosted preview: set a nonempty provider CA PEM instead of a local path.
# For local DATABASE_CA_FILE mode, leave this variable unset (not an empty override).
# DATABASE_CA_PEM=
SUPABASE_PROJECT_REF=
# Upload completion runs inside a bounded web request. No ClamAV or Worker configuration.
# Free plan effective maximum. Business cap remains 100 MiB; plan/global cap wins.
STORAGE_MAX_FILE_BYTES=52428800
# Optional, test diagnostics only. Fixed duration/count labels; no user data or SQL.
# Disabled by default; reports response-to-headers time, not full streamed download.
PM_SERVER_TIMING=0
# Optional operator-only maintenance. Never import admin URLs/backup keys into hosted app variables.
# WORKER_DATABASE_URL= restricted maintenance role; not a running upload worker
# PM_POSTGRES_BIN=C:/Program Files/PostgreSQL/18/bin
# PM_BACKUP_KEY_FILE=D:/PartMeasure/tmp/maintenance-keys/operator.backup-key
# PM_BACKUP_DATABASE_URL_FILE=D:/PartMeasure/tmp/operator/backup-database-url.txt
# PM_BACKUP_SET=D:/PartMeasure/tmp/backups/<set-id>
# PM_BACKUP_COPY_DIRECTORY=<new-approved-private-destination>; ciphertext only, never put the key here
# PM_RESTORE_DATABASE_URL_FILE=D:/PartMeasure/tmp/operator/local-restore-url.txt
