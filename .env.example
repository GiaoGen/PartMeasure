# Populate an ignored .env.local. APP_URL is the exact allowed browser Origin.
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Prefer the current secret key.
SUPABASE_SECRET_KEY=
# Restricted partmeasure_runtime transaction-pooler URL; never postgres/service_role.
DATABASE_URL=
WORKER_DATABASE_URL=
# Supabase Dashboard SSL Certificate, kept outside version control.
DATABASE_CA_FILE=
SUPABASE_PROJECT_REF=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
# Free plan effective maximum. Business cap remains 100 MiB; plan/global cap wins.
STORAGE_MAX_FILE_BYTES=52428800
